msgid ""
"data/blueprints.xml.append$//systemBlueprint[@name=\"og_turret_adaptive_2\"]/desc"
msgstr ""
"Alimente la tourelle de votre vaisseau. L'amélioration réduit le temps de "
"charge de la tourelle. La position de la tourelle peut être modifiée en "
"dehors du combat pour mieux s'adapter au vaisseau, peut être améliorée en un"
" emplacement de grande tourelle dans le menu d'amélioration interne."

#: src-en/data/blueprints.xml.append:293
