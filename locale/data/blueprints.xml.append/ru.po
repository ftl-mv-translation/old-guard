#: src-en/data/blueprints.xml.append:375
msgid ""
"data/blueprints.xml.append$//crewBlueprint[@name=\"human_og_raider\"]/powerList/power[1]"
msgstr ""
"Дает 2 единицы энергии текущей системе, находясь у пульсара или ионного "
"шторма"

#: src-en/data/blueprints.xml.append:376
msgid ""
"data/blueprints.xml.append$//crewBlueprint[@name=\"human_og_raider\"]/powerList/power[2]"
msgstr "Видит соседние отсеки, находясь в туманности"

#: src-en/data/blueprints.xml.append:377
