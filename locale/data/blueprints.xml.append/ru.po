#: src-en/data/blueprints.xml.append:6152
msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_SHIP_OG_HUNTER_3\"]/desc"
msgstr ""
"Усовершенствованная версия первого нейтронного луча, на этот раз в виде "
"турели, способная наносить невероятный урон после модернизации."

#: src-en/data/blueprints.xml.append:6242
msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_SHIP_OG_DRIFTER\"]/class"
msgstr "Класс \"Дрифтер\""

