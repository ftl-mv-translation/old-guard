"защиты ему приходится полагаться на свои турели."

#: src-en/data/blueprints.xml.append:5895
msgid ""
"data/blueprints.xml.append$//shipBlueprint[@name=\"PLAYER_SHIP_OG_DAWN_BIG_3\"]/class"
msgstr "Класс \"Колосс\""

#: src-en/data/blueprints.xml.append:5896
