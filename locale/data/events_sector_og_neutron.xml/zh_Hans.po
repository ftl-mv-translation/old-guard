#: src-en/data/events_sector_og_neutron.xml:747
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[1]"
msgstr "\"好了好了，你们赢了！拿走我们店里的一些装备，放过我们吧！\""

#: src-en/data/events_sector_og_neutron.xml:748
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[2]"
msgstr "对方舰船反复向你发起呼叫。看来他们想要投降。"

#: src-en/data/events_sector_og_neutron.xml:749
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[3]"
msgstr "\"你比我们想象中装备精良多了。我们投降。\""

#: src-en/data/events_sector_og_neutron.xml:750
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[4]"
msgstr "他们向你发了一条消息：\"你的星舰装备真是精良！请拿走这件装备放我们一条生路吧。\""

#: src-en/data/events_sector_og_neutron.xml:751
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[5]"
msgstr "\"求求你不要杀死我们。我们所有东西都给你！\""

#: src-en/data/events_sector_og_neutron.xml:752
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[6]"
msgstr "他们提议如果放他们一条生路就把部分货物送给你。"

#: src-en/data/events_sector_og_neutron.xml:753
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[7]"
msgstr "他们提议如果不摧毁他们舰船就把部分货物送给你。"

#: src-en/data/events_sector_og_neutron.xml:754
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[8]"
msgstr "你收到一条慌张的消息，\"我们所有东西都给你！千万别杀死我们！\""

#: src-en/data/events_sector_og_neutron.xml:755
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[9]"
msgstr "\"显然是你更胜一筹。我们只求活命。\""

#: src-en/data/events_sector_og_neutron.xml:756
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[10]"
msgstr "\"你的意图我们领会了，我们被打败了。拿走这些让我们自取其辱吧。\""

#: src-en/data/events_sector_og_neutron.xml:757
msgid ""
"data/events_sector_og_neutron.xml$//textList[@name=\"TEXT_SURRENDER_OG_MIDNIGHT\"]/text[11]"
msgstr "\"把我们东西都拿走吧，我们就当刚才的事从没发生过。\""

