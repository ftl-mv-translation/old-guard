"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DISTRESS_CIVILIAN\"]/choice[2]/text"
msgstr "Не обращать внимания на корабль."

#: src-en/data/events_sector_og_neutron.xml:1507
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DISTRESS_CIVILIAN\"]/choice[2]/event/text"
msgstr "Вы избегаете корабля и готовитесь к следующему прыжку."

#: src-en/data/events_sector_og_neutron.xml:1509
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DISTRESS_CIVILIAN\"]/choice[2]/event/choice[1]/text"
msgstr "Заняться чем-либо на корабле."

#: src-en/data/events_sector_og_neutron.xml:1513
msgid ""
