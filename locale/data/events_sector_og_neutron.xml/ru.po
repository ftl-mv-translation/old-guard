#: src-en/data/events_sector_og_neutron.xml:1492
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DISTRESS_CIVILIAN\"]/text"
msgstr ""
"Прибыв к месту сигнала бедствия, вы обнаруживаете, что источником сигнала "
"является гражданский шаттл, а причиной их бедствия - корабль Нового "
"рассвета, стремительно приближающийся к ним с готовым к бою оружием."

#: src-en/data/events_sector_og_neutron.xml:1494
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DISTRESS_CIVILIAN\"]/choice[1]/text"
msgstr "Помочь гражданским."

#: src-en/data/events_sector_og_neutron.xml:1496
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DISTRESS_CIVILIAN\"]/choice[1]/event/text"
msgstr "Вы включаете оружие и приступаете к атаке."

#: src-en/data/events_sector_og_neutron.xml:1499
msgid ""
"data/events_sector_og_neutron.xml$//event[@name=\"OG_NEUTRON_DISTRESS_CIVILIAN\"]/choice[1]/event/choice/text"
msgstr "Продолжить..."

