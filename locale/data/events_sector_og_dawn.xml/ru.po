#: src-en/data/events_sector_og_dawn.xml:528
msgid ""
"data/events_sector_og_dawn.xml$//event[@name=\"STOREEVENT_OG_DAWN_TURRET_COVERUP_PURCHASE_100\"]/text"
msgstr ""
