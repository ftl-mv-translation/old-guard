msgid ""
"data/events_sector_og_dawn.xml$//event[@name=\"OG_DAWN_PREIGN_QUEST_DESTINATION\"]/choice[1]/event/choice[1]/event/choice[2]/text"
msgstr "\"О, э-э, у нас его больше нет\"."

#: src-en/data/events_sector_og_dawn.xml:1642
msgid ""
"data/events_sector_og_dawn.xml$//event[@name=\"OG_DAWN_PREIGN_QUEST_DESTINATION\"]/choice[1]/event/choice[1]/event/choice[2]/event/text"
msgstr ""
