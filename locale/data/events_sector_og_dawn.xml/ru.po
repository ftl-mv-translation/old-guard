msgstr ""
"Вы мчитесь обратно к своему кораблю, отчаянно пытаясь увести его подальше от станции, пока он не был поврежден в суматохе.\n"
"Вы отстыковываетесь от станции и начинаете удаляться, когда вражеский корабль обращает на вас свое внимание, в кабине загораются предупреждающие сигналы, предупреждающие вас об опасности, готовьтесь к бою."

#: src-en/data/events_sector_og_dawn.xml:1626
msgid ""
"data/events_sector_og_dawn.xml$//event[@name=\"OG_DAWN_PREIGN_QUEST_DESTINATION\"]/choice[1]/event/choice[1]/event/choice[@req=\"OG_CARGO_CRATE_PREIGN_WEAK\"]/event/choice/event/choice/event/choice/event/choice/event/choice/text"
msgstr "Продолжить..."

