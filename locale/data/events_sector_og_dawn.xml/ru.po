msgid ""
"data/events_sector_og_dawn.xml$//event[@name=\"OG_DAWN_HEIST_QUEST_IRON\"]/beaconType/unvisitedTooltip"
msgstr ""
"Местонахождение хранилища данных Нового рассвета, которое станет объектом "
