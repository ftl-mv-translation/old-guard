#: src-en/data/hyperspace.xml.append:1848
msgid ""
"data/hyperspace.xml.append$//achievement[@name=\"ACH_OG_BATTLECRUISER_SLUG\"]/secretDescription"
msgstr "Получите прототипную турель с линейного крейсера Клептократии."

#: src-en/data/hyperspace.xml.append:1849
