#: src-en/data/text_misc.xml.append:47
msgid "data/text_misc.xml.append$//text[@name=\"loot_og_dawn_1\"]"
msgstr ""
"ПРОТОТИП НОВОГО РАССВЕТА\n"
"Накладывает уязвимость на пораженные помещения на 5 секунд.\n"
"-1 секунда к времени перезарядки"

#: src-en/data/text_misc.xml.append:50
msgid "data/text_misc.xml.append$//text[@name=\"loot_og_midnight_1\"]"
msgstr ""
"ПРОТОТИП ПОЛУНОЧНОГО СОЛНЦА\n"
"Хакеры наносят урон по отсекам в течение 2 секунд\n"
"-1 секунда времени перезарядки за каждую цепь"

#: src-en/data/text_misc.xml.append:54
msgid "data/text_misc.xml.append$//text[@name=\"og_turret_loot_slug_1\"]"
msgstr ""
"ПРОТОТИП СЛИЗНЕЙ\n"
"+1 к урону по системам, +15 к урону экипажу\n"
"+20% к вероятности пробоины"

#: src-en/data/text_misc.xml.append:57
msgid "data/text_misc.xml.append$//text[@name=\"og_turret_loot_clan_1\"]"
msgstr ""
"ПРОТОТИП КЛАНОВЦЕВ\n"
"Оглушает экипаж на 3 секунды\n"
"+120 к наведению\n"
"-0.5 секунды к времени перезарядки"

#: src-en/data/text_misc.xml.append:61
msgid "data/text_misc.xml.append$//text[@name=\"og_turret_loot_crystal_1\"]"
msgstr ""
"ПРОТОТИП КРИСТАЛЛИНОВ\n"
"Выпускает кристаллические мины\n"
"+120 к наведению\n"
"+1 снаряд\n"
"+5 секунд к скорости перезарядки"

#: src-en/data/text_misc.xml.append:67
msgid "data/text_misc.xml.append$//text[@name=\"og_turret_loot_federation_1\"]"
msgstr ""
"ПРОТОТИП ФЕДЕРАЦИИ\n"
"Может поражать все снаряды и дроны\n"
"+2 заряда\n"
"-1 секунда к скорости перезарядки"

