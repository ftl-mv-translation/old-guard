#: src-en/data/events_sector_showdown.xml.append:23
msgid ""
"data/events_sector_showdown.xml.append$//event[@name=\"TRUE_VICTORY_CREW_OG_HORUS\"]/text"
msgstr ""
"\"Когда я попросил, чтобы меня доставили на БАЗУ ФЕДЕРАЦИИ, и вы "
"СОГЛАСИЛИСЬ, почему же вы потом решили, что будет хорошей идеей привезти "
"меня сюда? Я не хотел иметь к всему этому никакого отношения, и уж точно не "
"хочу, чтобы меня взорвали!\""

#: src-en/data/events_sector_showdown.xml.append:27
